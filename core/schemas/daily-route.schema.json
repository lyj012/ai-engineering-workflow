{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-workflow.local/schemas/daily-route.schema.json",
  "title": "Daily Route Decision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "finalStatus": {
      "type": "string",
      "enum": [
        "ROUTE_FAST_DEV",
        "ROUTE_FEATURE_DEV",
        "ROUTE_BUGFIX",
        "ROUTE_REFACTOR",
        "ROUTE_REVIEW",
        "ROUTE_DELIVERY_SUMMARY",
        "ROUTE_PRE_PUSH_CHECK",
        "ROUTE_GIT_PUBLISH",
        "ROUTE_ANALYSIS",
        "ROUTE_FORMAL_DELIVERY",
        "ROUTE_FULL_WORKFLOW",
        "ROUTE_NEEDS_CLARIFICATION"
      ]
    },
    "route": { "type": "string" },
    "flow": { "type": "string" },
    "verificationLevel": {
      "type": "string",
      "enum": ["none", "read-only", "light", "core-path", "submit-ready", "necessary", "full"]
    },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "highRiskMatches": { "type": "array", "items": { "type": "string" } },
    "stopBeforeGitWrites": { "type": "boolean" }
  },
  "required": ["finalStatus", "route", "flow", "verificationLevel", "reasons", "warnings", "stopBeforeGitWrites"]
}
